# Local Postgres from docker-compose.yml. These defaults are also hardcoded
# so `pnpm dev` works without copying this file.
DATABASE_URL=postgres://freight:freight@localhost:5432/freight

# Leave unset to run the deterministic mock model (tests, evals, and the
# default desk). Set both to call a real provider instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to 1 to ignore OPENAI_API_KEY. The test runner and `pnpm eval` do this.
OPERATOR_FORCE_MOCK=
